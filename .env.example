# The .env of standalone Ariadne (docker-compose.yml, docs/STANDALONE.md).
#
#   deploy/standalone/init-env.sh     copies this file to .env and fills in the secrets with openssl rand
#
# Only the lines without "#" are required; the commented ones show the default value.

# --- Profiles: what starts besides the core (postgres, kiwix, server, worker, worker-heavy, init, bootstrap) ---
# wiki (Wiki.js), books (Calibre + Kavita), courses (Moodle + CodeRunner + Jobe), translate (LibreTranslate),
# llm (the curator on CPU) or all. When you drop a profile, also set its URL to empty (below, "Services").
COMPOSE_PROFILES=all

# --- Secrets: all `change-me` here; init-env.sh swaps them for random values (openssl rand), and compose ---
# --- refuses to start while any is still `change-me` (the `init` service). None has a default value.     ---
# Postgres (user 'ariadne'). Letters and digits only: it goes as-is into DATABASE_URL.
POSTGRES_PASSWORD=change-me
# The master key of the integrations vault: the tokens that `bootstrap` obtains from Wiki.js, Moodle and Kavita
# are stored encrypted in the database with it (as is whatever you enter in dashboard → Integrations). Keep a copy
# outside this file too: without it the vault cannot be read. `openssl rand -base64 32` or `ariadne secrets generate-key`.
ARIADNE_MASTER_KEY=change-me
# The Wiki.js administrator (`bootstrap` runs the setup with it).
WIKIJS_ADMIN_EMAIL=admin@ariadne.invalid
WIKIJS_ADMIN_PASSWORD=change-me
# Moodle: the administrator and the "ariadnews" service user (the token comes from it).
MOODLE_ADMIN_PASSWORD=change-me
MOODLE_WS_PASSWORD=change-me
# The Jobe gateway key (Moodle, the server and the worker send it) and the Calibre agent key.
JOBE_API_KEY=change-me
CALIBRE_API_KEY=change-me
# The Kavita administrator (`bootstrap` creates it; the first registration on a new Kavita is the administrator).
KAVITA_ADMIN_USERNAME=ariadne
KAVITA_ADMIN_PASSWORD=change-me
# The curator key (`llm` profile): llama-server only answers with it.
CURATOR_API_KEY=change-me
# The password of the gpu-gateway's restricted Postgres role (`tunel` profile; `bootstrap` creates the role).
GPU_GATEWAY_DB_PASSWORD=change-me

# --- Ariadne images (server, kiwix, curator, jobe, moodle, calibre) ---
# By default they are built from this repository (`docker compose up -d --build`). To use the ones from a public
# registry, set these two and run `docker compose pull` and then `docker compose up -d` (without --build):
# ARIADNE_IMAGE_PREFIX=<registry>/<owner>/ariadne-   # the image becomes <prefix>server:<tag>, <prefix>kiwix:<tag>, …
# ARIADNE_TAG=<version>

# --- Data folders (on the host; `init` leaves them owned by user 1000) ---
# The .zim files (the dashboard also downloads them from the Kiwix catalog into here):
# ZIM_DIR=./data/zim
# COURSES_DIR=./data/courses
# BACKUP_DIR=./data/backups

# --- Published ports and public URLs (as the browser sees them; they go into the responses) ---
# Address where the ports open, deliberately without a default (compose refuses to start without it). init-env.sh sets
# the loopback of this machine here (`localhost` resolved): the ports only open on the server itself. To expose them,
# put an HTTPS proxy in front (docs/STANDALONE.md, "Exposing it beyond this machine"), not another address here.
PUBLISH_ADDRESS=
# ARIADNE_PORT=8800
# KIWIX_PORT=8801
# WIKIJS_PORT=8802
# The internal services (Postgres, Calibre, Jobe gateway, LibreTranslate, curator) do not publish ports. For tests
# and maintenance: COMPOSE_FILE=docker-compose.yml:deploy/standalone/ports.yml (with the same PUBLISH_ADDRESS), with the ports POSTGRES_PORT=5432, CALIBRE_PORT=8807, JOBE_PORT=8804, LIBRETRANSLATE_PORT=8803
# and CURATOR_PORT=8085 (the defaults).
# Outside this machine, its address (default http://localhost:<port>):
# KIWIX_PUBLIC_URL=http://<host>:8801
# WIKIJS_PUBLIC_URL=http://<host>:8802

# --- Services (by default the ones in compose; empty = off; or one you already have on another machine) ---
# With the profile off, its URL must stay empty, otherwise /health reports "degraded":
# WIKIJS_URL=                        # without `wiki`
# MOODLE_URL=                        # without `courses` (and JOBE_URL=)
# JOBE_URL=
# CALIBRE_URL=                       # without `books` (and KAVITA_URL=)
# KAVITA_URL=
# LIBRETRANSLATE_URL=                # without `translate`
# CURATOR_URL=                       # without `llm`
# The tokens WIKIJS_TOKEN, MOODLE_TOKEN, KAVITA_API_KEY and KAVITA_LIBRARY_ID are obtained by `bootstrap` into the vault; set
# them here only to point at an already configured service (the vault value wins over the environment one).
# Locales published to Wiki.js (by default, those of namespacing, which bootstrap enables as en,pt).
# WIKIJS_LOCALES=en,pt
# Heat above which a document goes to Wiki.js (its first-order neighbors follow it).
# IMPORT_HEAT_THRESHOLD=3

# --- Curation (STRUCTURE.md, section 5) ---
# Only what triggers flags (injection, long base64, dangerous commands, dosages) and health content goes to the
# curator; the rest is published directly. Without CURATOR_URL those cases are held back (pending_curator).
# By default the `curator` of the `llm` profile: llama-server on CPU (no AVX), Gemma 3 4B pinned in
# deploy/curator/model.lock (~2.5 GB, downloaded the first time). With a GPU on another machine (an OpenAI-compatible
# llama-server or Ollama), point CURATOR_URL there and add the host to PRIVATE_ALLOWED_HOSTS.
# CURATOR_MODEL=gemma-3-4b-it
# Where the model comes from (empty = Hugging Face). Without access to it: a mirror with the same file, or copy it
# into the volume (docker compose cp gemma-3-4b-it-Q4_K_M.gguf curator:/models/); the sha256 still checks it.
# CURATOR_MODEL_URL=
# CURATOR_THREADS=0                  # 0 = all CPUs
# CURATOR_CTX=16384
# CURATOR_MEM_LIMIT=6g
# CURATOR_TIMEOUT_SECONDS=1800
# CURATION_MAX_CHARS=12000           # the text goes to the curator in chunks of this size
# Batch on Kaggle's free GPU (Curation panel; needs internet). Create the token at kaggle.com/settings
# (or set it in dashboard → Integrations). Colab is manual (download the package from the panel).
# KAGGLE_USERNAME=
# KAGGLE_API_TOKEN=
# KAGGLE_WEEKLY_GPU_HOURS=30
# BATCH_AUTO_PUBLISH=false           # false: what the curator rewrites (local or external GPU) waits for your validation.
#                                    # Only change to true after several batches validated on both paths.
# The Kaggle batch runs through files (dataset + output) and needs nothing open to the internet. Optional: the
# batch tunnel (`tunel` profile, docs/WIKI-IMPORT.md section 7), with YOUR OWN Cloudflare tunnel: the notebook talks
# to the gpu-gateway during runs. Put the JSON from `cloudflared tunnel create` in
# ./data/secrets/gpu-tunnel/tunnel.json and the public hostname you gave it here (without a URL it stays off):
# GPU_GATEWAY_PUBLIC_URL=https://gpu-lote.exemplo.org
# GPU_GATEWAY_ACCESS_ID=             # Cloudflare Access service token (optional, second layer at the edge)
# GPU_GATEWAY_ACCESS_SECRET=
# GPU_TUNNEL_DIR=./data/secrets/gpu-tunnel
# Fraction of the articles without flags that the curator also sees, to tune the rules (0 = none).
# CURATION_SAMPLE_RATE=0

# --- Languages and translation (STRUCTURE.md, section 9; ARCHITECTURE.md, section 8) ---
# LibreTranslate of the `translate` profile (empty = translation off; everything else works). It must be a LOCAL service:
# the text of the questions and articles goes there. The first time it downloads the models for these languages:
# LIBRETRANSLATE_LANGUAGES=en,pt
# LIBRETRANSLATE_API_KEY=
# Argos tends towards PT-BR. With a PT-PT model loaded on the server, the code it uses:
# LIBRETRANSLATE_PT_CODE=pt-PT
# A PT⇄EN question is also searched in the other language; the historical rule brings the "original source".
# TRANSLATE_QUERIES=true
# ROUTER_HISTORICAL_RULE=true
# Terms that are not translated, besides code and URLs (empty = default list).
# TRANSLATE_PROTECTED_TERMS=Python,Docker,pgvector
# TRANSLATE_CONCURRENCY=4            # text translations at the same time
# TRANSLATE_CACHE_TTL_DAYS=90        # the translation cache forgets anything older
# TRANSLATE_CACHE_MAX_ROWS=100000

# --- Embeddings and level 3 (all optional) ---
# onnx (local, CPU), llamacpp or http (/v1/embeddings endpoint at EMBEDDER_URL; requires EMBEDDER_MODEL_ID).
# EMBEDDER=onnx
# fp32 (470 MB) or int8 (118 MB, faster; gives different vectors: the model_id gets ':int8').
# EMBEDDER_VARIANT=fp32
# EMBEDDER_URL=http://llama:8080
# EMBEDDER_MODEL_ID=intfloat/multilingual-e5-small@614241f
# Chunks vectorized per day (UTC) and router thresholds (ARCHITECTURE.md, sections 5 and 6).
# INDEX_DAILY_BUDGET=20000
# Neighbors (section 6): heat above which it expands, and maximum new neighbors per expansion.
# NEIGHBORS_HEAT_THRESHOLD=5
# NEIGHBORS_MAX_PER_DOC=50
# Cross-source graph (section 7): cosine that proposes, and that immediately accepts, a vector link.
# LINK_TAU=0.88
# LINK_TAU_ACCEPT=0.94
# ROUTER_TAU_HIGH=0.86
# ROUTER_TAU_LOW=0.80
# Rooms (section 4.5): topics inside each wing, computed from the article vectors (`ariadne rooms build`).
# A wing recomputes its rooms when it grows by ROOMS_GROWTH; the results of the ROUTER_ROOMS_TOP rooms
# closest to the question get ROUTER_ROOM_BONUS in the fusion.
# ROOMS_MIN=8
# ROOMS_MAX=200
# ROOMS_MIN_DOCUMENTS=16
# ROOMS_GROWTH=0.25
# ROOMS_TRAIN_SAMPLE=100000
# ROOMS_SEED=9
# Cosine (with the wing mean removed) above which a recomputed room inherits the old one's id.
# ROOMS_MATCH_SIMILARITY=0.7
# Switching embedding model only replaces a wing's rooms when the new model covers this fraction of the articles.
# ROOMS_MODEL_SWITCH_COVERAGE=0.9
# ROOMS_ASSIGN_BATCH=5000
# ROOMS_INTERVAL_SECONDS=600
# ROUTER_ROOMS_TOP=3
# ROUTER_ROOM_BONUS=0.002
# Level 3 storage: pgvector (default) or mempalace (mirrors wings and rooms to MemPalace;
# needs the optional extra ariadne[mempalace], which is not in the image, and MEMPALACE_DSN: without either it
# starts with pgvector and /health says why).
# SEMANTIC_STORE=pgvector
# Mirror Postgres (preferably a database of its own, not Ariadne's; the password stays only here,
# MemPalace does not store it in the palace) and the palace folder (server/worker volume).
# MEMPALACE_DSN=                     # the connection URL of the mirror Postgres (with its user and password)
# MEMPALACE_PALACE_DIR=/models/mempalace
# MEMPALACE_INTERVAL_SECONDS=900

# --- Courses (STRUCTURE.md, section 6.2; ARCHITECTURE.md, section 4.7) ---
# Git repository of the canonical format: COURSES_DIR (above), outside the code repository.
# Moodle + CodeRunner (`courses` profile). The `moodle` database is created on its own when the container starts, the first time
# it installs Moodle (minutes) and `bootstrap` obtains the service token into the vault (MOODLE_TOKEN stays empty here).
# Passwords require upper case, lower case, a digit and a symbol (init-env.sh generates them that way).
# Outside this machine: host:port as the browser sees Moodle (also the `wwwroot` one) and the URL for the responses.
# MOODLE_PUBLIC_HOST=<host>:8805
# MOODLE_PUBLIC_URL=http://<host>:8805
# Moodle: restricts the service token to these IPs/CIDRs (comma-separated). Empty = any IP (the server and the worker have no
# fixed IP in compose); fill it in if you pin them (or if Moodle is exposed outside the compose network).
# MOODLE_TOKEN_IPS=
# MOODLE_TOKEN_DAYS=365
# Jobe: code sandbox (CodeRunner and `ariadne sandbox`). In compose it sits on an internal network, behind the jobe-gateway
# (nginx: API key, per-client request limit, REST API only), with no published port.
# JOBE_API_KEY is required: the gateway demands it, and Moodle (CodeRunner), the server and the worker send it. Moodle can only
# call the gateway's IP (resolved by name on each request): the other private networks are blocked (SSRF).
# On another machine: JOBE_URL=http://<host>:<port> (and in Moodle JOBE_HOST, MOODLE_BLOCKED_HOSTS without that IP),
# with the gateway accepting only Moodle's IP (JOBE_ALLOW).
# JOBE_RATE_LIMIT=30          # requests per second per client (IP)
# JOBE_RATE_BURST=60
# JOBE_MAX_CONNECTIONS=16
# Classification on ingestion (article, course or book), when the ZIM metadata is misleading:
# SOURCE_CLASS_OVERRIDES=zim:wikibooks_en_all=book,zim:wikibooks_en_all/Python=course

# --- Books (STRUCTURE.md, section 6.3; ARCHITECTURE.md, section 4.8) ---
# The Calibre library (`books` profile; folder shared with Kavita, owned by user 1000: `init` sets it up).
# BOOKS_DIR=./data/books
# The first registration on a new Kavita is the administrator: that is why the reader port (KAVITA_PORT) only opens after
# `bootstrap-books` creates the administrator (KAVITA_ADMIN_*), the library and the key (they go to the vault).
# KAVITA_PORT=8806
# KAVITA_PUBLIC_URL=http://<host>:8806
# `books add` refuses larger files (default 300 MiB).
# BOOKS_MAX_BYTES=314572800

# License classes (STRUCTURE.md, section 7): private text only goes to services on these hosts (curator,
# HTTP embeddings, translator, Moodle, Wiki.js, Jobe). Empty = the compose services (including `curator`) and
# localhost. A service outside compose (a curator with a GPU on another machine) goes in the WHOLE list, on purpose:
# PRIVATE_ALLOWED_HOSTS=localhost,postgres,kiwix,wikijs,moodle,jobe-gateway,calibre,kavita,libretranslate,curator,<o teu host>
# PRIVATE_ALLOWED_HOSTS=

# --- Kiwix catalog, backups and releases (Phase 12; STRUCTURE.md, sections 4 and 16) ---
# OPDS catalog from which the dashboard (Sources) downloads ZIM files into ZIM_DIR (`init` leaves the folder owned by user
# 1000, the one of worker-heavy). kiwix-serve picks up the new ZIM by itself.
# KIWIX_CATALOG_URL=https://library.kiwix.org/catalog/v2/entries
# Local backups (`docker compose exec worker ariadne backup create`): full pg_dump (private included!) of the
# ariadne, wikijs and moodle databases + the courses. It never leaves this machine.
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=4
# Weekly external release: ONLY the open class, encrypted with age to the PUBLIC key below, in parts of at most
# 2 GB. Generate the pair outside the system (age-keygen -o private-key.txt) and put only the "age1…" line here. The
# private key never enters the server or this file.
# RELEASE_AGE_RECIPIENT=age1…
# AUTHENTICITY: each release manifest is signed with its OWN signing key (ed25519), distinct from the age one.
#   ssh-keygen -t ed25519 -N '' -C ariadne-release -f release_signing
# The private one stays in a read-only file mounted into worker-heavy (RELEASE_SIGNING_KEY_PATH, on the host:
# by default ./data/secrets/release_signing_key); put the PUBLIC one ("ssh-ed25519 AAAA…", without the comment) here and
# ALSO PIN IT OUTSIDE GITHUB (README, password manager): restore uses it to verify the release.
# RELEASE_SIGNING_KEY_PATH=./data/secrets/release_signing_key
# RELEASE_SIGNING_PUBKEY=ssh-ed25519 AAAA…
# Off by default: with false nothing is published or scheduled (building by hand and rehearsing with --dry-run works).
# RELEASE_ENABLED=false
# RELEASE_GITHUB_REPO=owner/repository
# RELEASE_GITHUB_TOKEN=            # token with permission to create releases in that repository
# RELEASE_INTERVAL_DAYS=7
# RELEASE_RETENTION=8
# RELEASE_PART_BYTES=2000000000
# RELEASE_REHEARSAL_DAYS=90        # the app warns when the last restore rehearsal is older than this
